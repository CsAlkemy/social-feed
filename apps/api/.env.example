PORT=3001
WEB_ORIGIN=http://localhost:3000
DATABASE_URL="postgresql://user:password@localhost:5432/appifylab_social"
JWT_ACCESS_SECRET="generate-a-long-random-string"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS="7"
# Vercel Blob store token — required for avatar uploads.
# Vercel dashboard → Storage → create/select a Blob store → .env.local tab, or `vercel env pull`.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"
