{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bun install && (cd apps/api && bunx prisma generate) && bunx turbo run build --filter=api",
    "watchPatterns": [
      "apps/api/**",
      "packages/shared/**",
      "package.json",
      "bun.lock",
      "turbo.json",
      "railway.json"
    ]
  },
  "deploy": {
    "startCommand": "bun apps/api/dist/main.js",
    "healthcheckPath": "/api/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
