{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "WEB_ORIGIN",
    "API_ORIGIN",
    "NEXT_PUBLIC_API_URL",
    "DATABASE_URL",
    "JWT_ACCESS_SECRET",
    "JWT_ACCESS_TTL_SECONDS",
    "REFRESH_TOKEN_TTL_DAYS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@repo/library#dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  }
}
