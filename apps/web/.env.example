# API base URL the browser calls.
# Local dev: http://localhost:3001/api — production: https://buddy-script-api.up.railway.app/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Socket.io server URL. Leave empty to derive it from NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_SOCKET_URL=

# Must match the API's REFRESH_TOKEN_TTL_DAYS (drives the authed-hint cookie lifetime).
NEXT_PUBLIC_REFRESH_TTL_DAYS=7

# Build-time origin the /api rewrite proxies to (defaults to the Railway API).
# API_ORIGIN=http://localhost:3001
